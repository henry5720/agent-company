#!/usr/bin/env python3
"""給 agent 一份這個 Slack thread 專屬、可寫的 repo 工作副本。

用法：`thread-workspace <channel_id> <thread_ts> <repo>`，成功時 stdout 只印一行路徑。
清理：`thread-workspace cleanup`（host cron 每小時 `docker compose exec` 進來跑，見 `cleanup()`）。

路徑由這支 helper 組成 `WORK_ROOT/<channel_id>-<thread_ts>/repos/<repo>/`，不讓 LLM
自己拼。channel 與 thread_ts 來自 OpenAB 放進 prompt 的 <sender_context>，跟
`slack-thread-artifact` 回貼目標是同一組識別；這是單一 container 內的信任約定，
不是身分驗證。

已存在就回傳原路徑，不重 clone、不跟 snapshot 同步；不存在才從唯讀 snapshot
`git clone --shared`，用 snapshot 當下的 HEAD、完整 checkout。`--shared` 只借用
snapshot 的物件，新 commit 寫在 workspace 自己的 `.git/objects`，snapshot 不會被改。

路徑處理跟 `slack-thread-artifact` 同一套：不用 resolve()，固定從 WORK_ROOT 開
dirfd，逐段 `O_DIRECTORY|O_NOFOLLOW` 往下走。git 只在 `repos/` 那個 fd 裡
clone 到一個暫存名，完成後用同一個 fd rename 成 repo 名；中間任何一層被換成
symlink，結果是失敗，不是寫到 root 外面。
"""

from __future__ import annotations

import errno
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import time
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.parse import urlencode
from urllib.request import Request, urlopen

WORK_ROOT = Path("/home/node/work")
SNAPSHOT_ROOT = Path("/home/node/code")
# 格式 pattern 跟 sandbox-run、slack-thread-artifact、sandbox/runner 逐字相同
# （tests/format-patterns.py 比對）；一律 fullmatch，`$` 會放過結尾的換行。
CHANNEL_PATTERN = re.compile(r"^[CDG][A-Z0-9]{8,32}$")
THREAD_TS_PATTERN = re.compile(r"^[0-9]{10,13}\.[0-9]{1,9}$")
# 開頭必須是英數：擋掉 `.`、`..`、隱藏目錄，也擋掉會被 git 當成選項的 `-` 開頭。
REPO_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$")
EXIT_INVALID_INPUT = 2
EXIT_RUNTIME = 3
CLONE_TIMEOUT_SECONDS = 600
# spec #21 §5：最後修改超過 7 天刪；總量超過 20 GB 從最久沒動的刪起。host 告警
# （scripts/alerts.py 的 THREAD_WORKSPACE_LIMIT_BYTES）用同一個上限，tests/host-alerts.py 比對。
MAX_AGE_SECONDS = 7 * 86400
MAX_TOTAL_BYTES = 20 * 1024 ** 3
KEY_PATTERN = re.compile(r"^[CDG][A-Z0-9]{8,32}-[0-9]{10,13}\.[0-9]{1,9}$")
TRASH_PREFIX = ".cleanup-"
SLACK_API = "https://slack.com/api"
SLACK_TIMEOUT_SECONDS = 15
NOTICE = "工作副本已清除，再改會從最新 snapshot 重來"

O_DIRECTORY = getattr(os, "O_DIRECTORY", 0)
O_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)


class InputError(Exception):
    pass


class RuntimeFailure(Exception):
    pass


def validate(argv: list[str]) -> tuple[str, str, str]:
    if len(argv) != 3:
        raise InputError("usage: thread-workspace <channel_id> <thread_ts> <repo>")
    channel, thread_ts, repo = argv
    # fullmatch：`$` 會放過結尾的換行。
    if not CHANNEL_PATTERN.fullmatch(channel):
        raise InputError("channel_id must be a Slack channel ID such as C0123456789")
    if not THREAD_TS_PATTERN.fullmatch(thread_ts):
        raise InputError("thread_ts must be a Slack timestamp such as 1710000000.123456")
    if not REPO_PATTERN.fullmatch(repo) or ".." in repo:
        raise InputError("repo must be a snapshot repo name, not a path")
    return channel, thread_ts, repo


def require_secure_flags() -> None:
    """沒有 O_NOFOLLOW／O_DIRECTORY 就沒有安全走法，直接拒絕而不是降級。"""
    if not O_NOFOLLOW or not O_DIRECTORY:
        raise RuntimeFailure(
            "this platform has no O_NOFOLLOW/O_DIRECTORY; refusing to touch the work root"
        )


def open_root(path: Path) -> int:
    try:
        return os.open(path, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW)
    except OSError as exc:
        raise RuntimeFailure(
            f"cannot open {path} as a real directory: {os.strerror(exc.errno)}"
        ) from exc


def open_dir_at(dir_fd: int, name: str, create: bool = False) -> int | None:
    """開一層目錄；不存在時 create=False 回 None，create=True 就建。

    O_NOFOLLOW 加 O_DIRECTORY 碰到 symlink 會回 ENOTDIR，不是 ELOOP。
    """
    if create:
        try:
            os.mkdir(name, 0o755, dir_fd=dir_fd)
        except FileExistsError:
            pass
    try:
        return os.open(name, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW, dir_fd=dir_fd)
    except FileNotFoundError:
        if create:
            raise RuntimeFailure(f"{name}/ disappeared while creating it") from None
        return None
    except OSError as exc:
        if exc.errno in (errno.ELOOP, errno.ENOTDIR):
            raise RuntimeFailure(f"{name} is a symlink or not a directory") from exc
        raise RuntimeFailure(f"cannot open {name}/: {os.strerror(exc.errno)}") from exc


def clone_into(repos_fd: int, source: Path, repo: str) -> None:
    """在 repos_fd 裡 clone 到暫存名，再用同一個 fd rename 成 repo。

    git 的 cwd 用 fchdir 設成 repos_fd，目的地是相對名稱，所以 git 寫入的位置就是
    已經驗過的那個目錄，不是事後重新解析的路徑字串。
    """
    temp = f".clone-{repo}-{os.getpid()}"
    try:
        subprocess.run(
            ["git", "clone", "--quiet", "--shared", "--", str(source), temp],
            preexec_fn=lambda: os.fchdir(repos_fd),
            env={**os.environ, "GIT_TERMINAL_PROMPT": "0"},
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            check=True,
            timeout=CLONE_TIMEOUT_SECONDS,
        )
        try:
            os.rename(temp, repo, src_dir_fd=repos_fd, dst_dir_fd=repos_fd)
        except OSError as exc:
            # 同時有另一個呼叫先建好了：用它的，丟掉自己的暫存 clone。
            if exc.errno not in (errno.ENOTEMPTY, errno.EEXIST):
                raise RuntimeFailure(f"cannot place clone: {os.strerror(exc.errno)}") from exc
    except subprocess.CalledProcessError as exc:
        raise RuntimeFailure(f"git clone failed: {exc.stderr.strip()}") from exc
    except subprocess.TimeoutExpired as exc:
        raise RuntimeFailure("git clone timed out") from exc
    finally:
        remove_temp(repos_fd, temp)


def remove_temp(repos_fd: int, temp: str) -> None:
    """清掉沒用到的暫存 clone。rmtree 帶 dir_fd 會用 fd 走、不跟 symlink。"""
    try:
        os.stat(temp, dir_fd=repos_fd, follow_symlinks=False)
    except FileNotFoundError:
        return
    shutil.rmtree(temp, dir_fd=repos_fd, ignore_errors=True)


def walk(key: str, repo: str, create: bool) -> tuple[list[int], bool]:
    """從 WORK_ROOT 逐段開到 `<key>/repos`；回傳一路的 fd 與 repo 目錄在不在。

    create=False 時任何一層不存在就停下，回傳 (fds, False)，不建任何東西。
    """
    fds = [open_root(WORK_ROOT)]
    try:
        for name in (key, "repos"):
            fd = open_dir_at(fds[-1], name, create=create)
            if fd is None:
                return fds, False
            fds.append(fd)
        existing = open_dir_at(fds[-1], repo)
        if existing is not None:
            os.close(existing)
        return fds, existing is not None
    except BaseException:
        close_all(fds)
        raise


def close_all(fds: list[int]) -> None:
    for fd in reversed(fds):
        os.close(fd)


def require_snapshot_repo(repo: str) -> None:
    """repo 必須是 snapshot root 底下的真目錄；symlink 不跟。"""
    snapshot_fd = open_root(SNAPSHOT_ROOT)
    try:
        try:
            source_fd = open_dir_at(snapshot_fd, repo)
        except RuntimeFailure as exc:
            raise InputError(f"snapshot repo {repo!r} is not a real directory") from exc
        if source_fd is None:
            raise InputError(f"unknown repo {repo!r}; not found in {SNAPSHOT_ROOT}")
        os.close(source_fd)
    finally:
        os.close(snapshot_fd)


def workspace(channel: str, thread_ts: str, repo: str) -> Path:
    require_secure_flags()
    key = f"{channel}-{thread_ts}"
    path = WORK_ROOT / key / "repos" / repo

    # 已存在就直接回傳：不碰 snapshot、不重 clone、不跟 snapshot 同步。
    fds, exists = walk(key, repo, create=False)
    close_all(fds)
    if exists:
        return path

    # 先確認 snapshot 有這個 repo，再建目錄：打錯 repo 名不會在 work root 留下空殼。
    require_snapshot_repo(repo)
    fds, exists = walk(key, repo, create=True)
    try:
        if not exists:
            clone_into(fds[-1], SNAPSHOT_ROOT / repo, repo)
    finally:
        close_all(fds)
    return path


def scan(root_fd: int, name: str) -> tuple[os.stat_result, float, int]:
    """回傳 thread 目錄本身的 lstat、整棵樹最新的 mtime、佔用 bytes。

    「最後修改」看整棵樹：agent 只改深層檔案時，頂層目錄的 mtime 不會變。
    fwalk 帶 dir_fd、follow_symlinks=False：symlink 只 lstat 自己，不走進去。
    """
    top = os.stat(name, dir_fd=root_fd, follow_symlinks=False)
    newest, used = top.st_mtime, top.st_blocks * 512
    for _, dirnames, filenames, dir_fd in os.fwalk(name, dir_fd=root_fd, follow_symlinks=False):
        for entry in dirnames + filenames:
            try:
                st = os.stat(entry, dir_fd=dir_fd, follow_symlinks=False)
            except FileNotFoundError:
                continue
            newest = max(newest, st.st_mtime)
            used += st.st_blocks * 512
    return top, newest, used


def remove_thread(root_fd: int, name: str, seen: os.stat_result) -> None:
    """同一個 root fd 裡先比對 identity、改名成暫存名，再 rmtree 那個暫存名。

    改名之後 `thread-workspace <channel> <ts>` 不會撿到刪一半的目錄；identity 不符
    （掃描後被換掉，例如換成 symlink）就不刪。rmtree 帶 dir_fd 不跟 symlink。
    """
    current = os.stat(name, dir_fd=root_fd, follow_symlinks=False)
    if not stat.S_ISDIR(current.st_mode) or (current.st_dev, current.st_ino) != (seen.st_dev, seen.st_ino):
        raise RuntimeFailure(f"{name} changed while cleaning; left in place")
    trash = f"{TRASH_PREFIX}{name}-{os.getpid()}"
    os.rename(name, trash, src_dir_fd=root_fd, dst_dir_fd=root_fd)
    shutil.rmtree(trash, dir_fd=root_fd)


def notify(key: str, token: str) -> None:
    # key 已經過 KEY_PATTERN；channel 與 thread_ts 都不含 `-`。
    channel, thread_ts = key.split("-", 1)
    if not token:
        raise RuntimeFailure("SLACK_BOT_TOKEN is not set")
    request = Request(
        f"{SLACK_API}/chat.postMessage",
        data=urlencode({"channel": channel, "thread_ts": thread_ts, "text": NOTICE}).encode("ascii"),
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/x-www-form-urlencoded",
        },
        method="POST",
    )
    try:
        with urlopen(request, timeout=SLACK_TIMEOUT_SECONDS) as response:
            result = json.loads(response.read())
    except (HTTPError, URLError, OSError, json.JSONDecodeError) as exc:
        raise RuntimeFailure(f"chat.postMessage failed: {exc}") from exc
    if not isinstance(result, dict) or result.get("ok") is not True:
        reason = result.get("error", "invalid response") if isinstance(result, dict) else "invalid response"
        raise RuntimeFailure(f"chat.postMessage rejected: {reason}")


def cleanup() -> int:
    """刪超過 7 天沒動的 thread workspace；總量仍超過上限就從最久沒動的刪起。

    只看 WORK_ROOT 底下名字符合 `<channel_id>-<thread_ts>` 的真目錄；其他東西（含
    symlink）不碰。每刪一個就在那個 thread 貼 NOTICE。通知失敗不會留著不刪（磁碟
    優先），但整次 exit 非 0，讓 host cron 的 log 記成 FAILED；單一目錄掃不了或刪不掉
    （OSError）也一樣記下來、繼續清其他的、exit 非 0。最後一行印
    `remaining_bytes=<N>`，host 告警用它判斷「清完仍超過上限」。
    """
    require_secure_flags()
    token = os.environ.get("SLACK_BOT_TOKEN", "")
    root_fd = open_root(WORK_ROOT)
    problems = 0
    try:
        threads = []
        for name in sorted(os.listdir(root_fd)):
            # 單一目錄的 OSError（權限、掃描中被刪）只記下來繼續清別的；整輪中止的話
            # 其他 thread 不會被清，host 也拿不到 remaining_bytes。
            if name.startswith(TRASH_PREFIX):
                # 上一次刪到一半被中斷留下的暫存名：直接收掉，不再通知。
                try:
                    st = os.stat(name, dir_fd=root_fd, follow_symlinks=False)
                    if stat.S_ISDIR(st.st_mode):
                        shutil.rmtree(name, dir_fd=root_fd)
                except OSError as exc:
                    print(f"FAILED to remove leftover {name}: {exc}", file=sys.stderr)
                    problems += 1
                continue
            if not KEY_PATTERN.fullmatch(name):
                continue
            try:
                top, newest, used = scan(root_fd, name)
            except OSError as exc:
                # 量不到大小：這個 thread 不刪、不算進 remaining_bytes。
                print(f"FAILED to scan {name}: {exc}", file=sys.stderr)
                problems += 1
                continue
            if not stat.S_ISDIR(top.st_mode):
                print(f"skip {name}: not a real directory", file=sys.stderr)
                continue
            threads.append((newest, name, top, used))

        now = time.time()
        threads.sort()
        total = sum(t[3] for t in threads)
        doomed = []
        for newest, name, top, used in threads:
            if now - newest > MAX_AGE_SECONDS:
                doomed.append((name, top, used, "age"))
                total -= used
        for newest, name, top, used in threads:
            if total <= MAX_TOTAL_BYTES:
                break
            if any(d[0] == name for d in doomed):
                continue
            doomed.append((name, top, used, "size"))
            total -= used

        for name, top, used, reason in doomed:
            try:
                remove_thread(root_fd, name, top)
            except (RuntimeFailure, OSError) as exc:
                print(f"FAILED to remove {name}: {exc}", file=sys.stderr)
                total += used
                problems += 1
                continue
            print(f"removed {name} reason={reason} bytes={used}")
            try:
                notify(name, token)
            except RuntimeFailure as exc:
                print(f"FAILED to notify {name}: {exc}", file=sys.stderr)
                problems += 1
    finally:
        os.close(root_fd)
    print(f"remaining_bytes={max(total, 0)}")
    return EXIT_RUNTIME if problems else 0


def main(argv: list[str]) -> int:
    if argv[:1] == ["cleanup"]:
        if len(argv) != 1:
            print("thread-workspace: usage: thread-workspace cleanup", file=sys.stderr)
            return EXIT_INVALID_INPUT
        try:
            return cleanup()
        except RuntimeFailure as exc:
            print(f"thread-workspace: {exc}", file=sys.stderr)
            return EXIT_RUNTIME
    try:
        path = workspace(*validate(argv))
    except (InputError, RuntimeFailure) as exc:
        print(f"thread-workspace: {exc}", file=sys.stderr)
        return EXIT_INVALID_INPUT if isinstance(exc, InputError) else EXIT_RUNTIME
    print(path)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
