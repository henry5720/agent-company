#!/usr/bin/env python3
"""公司 gateway 生圖／改圖的唯一入口。

這支 CLI 是刻意收窄的：

- mode 只有 `generate` 與 `edit` 兩個固定值，沒有第三種。
- 只接受 prompt、允許清單內的 size，以及 `edit` 的來源圖片路徑。
- 沒有 endpoint、header、model、輸出路徑這類參數 —— 呼叫者無法把請求導到
  別的地方，也無法把檔案寫到 drafts 以外。
- 請求一律送到 host proxy，位置只從 runtime env `COMPANY_GATEWAY_BASE_URL` 讀
  （production 是 bridge 上的 `http://10.231.0.1:18080`，正本 config/host-network.env），
  不寫在原始碼、不接受參數覆蓋。
- key 不在 container 裡：host Caddy proxy 補上 Authorization（config/caddy/Caddyfile），
  所以這支不讀 key、不送 Authorization header。proxy 在 bridge 上走 plain http，
  因此也不要求 https。
- 輸出一律是 PNG，一律落在 `/home/node/drafts/<UTC 日期>/`。

請求走公司 gateway 的 Responses API `image_generation` tool：`generate` 只送
prompt，`edit` 另外把來源圖片以 data URL 當成 `input_image` 一起送。

回應有兩種形狀，兩種都要接：一種是一般的 JSON body，一種是
`Content-Type: text/event-stream` 的 SSE（實測公司 gateway 會回這一種，事件裡帶
`response.image_generation_call.partial_image`）。所以讀法看 Content-Type 決定，
不預設哪一種；SSE 逐行讀，單行與整份都有上限。SSE 的 `partial_image_b64` 每次都是
一張完整的圖而不是要接起來的 chunk，因此同一個 output 後到的取代先到的，收尾事件
（output item 或整份 response）優先於 partial。兩條路徑最後都走同一組 base64 解碼、
PNG magic 檢查與原子寫檔。

檔案系統的走法刻意不用 resolve()：resolve 跟著 symlink 走，檢查過的字串和真正
開到的檔案可以是兩回事。來源圖片固定從允許的那個 root 開一個 dirfd，再逐段
`O_DIRECTORY|O_NOFOLLOW` 往下走。輸出也一樣：日期目錄以 dirfd 握住（gateway 呼叫
期間它不可能被換成 symlink），檔名用 `O_CREAT|O_EXCL|O_NOFOLLOW` 佔住，內容先寫
暫存檔再 fsync、rename 蓋回去。父目錄被替換的結果是失敗，不是寫到 drafts 以外。

Exit code：0 成功、2 輸入不合法、3 環境或 gateway 失敗。
"""

from __future__ import annotations

import argparse
import base64
import binascii
import errno
import io
import json
import os
import re
import stat
import sys
from datetime import datetime, timezone
from pathlib import Path, PurePosixPath
from urllib.error import HTTPError, URLError
from urllib.parse import urlparse
from urllib.request import Request, urlopen

# 生圖用的模型，由 gateway 解讀；proxy 不看 body。
MODEL = "gpt-5.6-terra"

ALLOWED_SIZES = ("1024x1024", "1024x1536", "1536x1024")
DEFAULT_SIZE = "1024x1024"
MAX_PROMPT_CHARS = 4000
MAX_SOURCE_BYTES = 8 * 1024 * 1024
REQUEST_TIMEOUT_SECONDS = 180

# 回應的上限。gateway 回什麼都不能讓這支 CLI 無上限地吃記憶體，所以 SSE 分「單行」
# 與「整份」兩層（一個 data 行就裝著整張圖的 base64，實測 ~1.2M 字元），非 SSE 的
# JSON body 一次讀完只需要一層，真正要解碼的 base64 另外再擋一次。
MAX_SSE_LINE_CHARS = 16 * 1024 * 1024
MAX_SSE_BODY_CHARS = 64 * 1024 * 1024
MAX_JSON_BODY_CHARS = 64 * 1024 * 1024
MAX_IMAGE_B64_CHARS = 16 * 1024 * 1024

# 錯誤事件只取得出短說明。整個 event 不會被印出來 —— 它裡面可能就是那張圖。
MAX_ERROR_DETAIL_CHARS = 200

SSE_MEDIA_TYPE = "text/event-stream"
SSE_DONE = "[DONE]"

PNG_MAGIC = b"\x89PNG\r\n\x1a\n"
JPEG_MAGIC = b"\xff\xd8\xff"

# 唯一的輸出位置。drafts 是 container 內少數可寫的路徑之一。
DRAFTS_ROOT = Path("/home/node/drafts")

# `edit` 的來源只能在這幾個 agent 自己寫得到的位置。唯讀 snapshot 不在裡面：
# repo 源碼沒有理由被送進 gateway。
SOURCE_ROOTS = (Path("/home/node/drafts"), Path("/home/node/.openab"), Path("/tmp"))

NAME_PATTERN = re.compile(r"[a-z0-9][a-z0-9-]{0,47}")

MAX_NAME_COLLISIONS = 99

EXIT_INVALID_INPUT = 2
EXIT_RUNTIME = 3

O_DIRECTORY = getattr(os, "O_DIRECTORY", 0)
O_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)


class InputError(Exception):
    """呼叫者給的東西不合法。"""


class RuntimeFailure(Exception):
    """環境或 gateway 的問題，不是呼叫者的錯。"""


def gateway_endpoint() -> str:
    """從 env 組出 Responses endpoint。沒有任何參數能覆蓋它。"""
    base = os.environ.get("COMPANY_GATEWAY_BASE_URL", "").strip()
    if not base:
        raise RuntimeFailure("COMPANY_GATEWAY_BASE_URL is not set in the runtime env")
    parsed = urlparse(base)
    if parsed.scheme not in ("http", "https") or not parsed.netloc:
        raise RuntimeFailure(f"COMPANY_GATEWAY_BASE_URL is not an http(s) URL: {base}")
    return base.rstrip("/") + "/responses"


def require_secure_flags() -> None:
    """沒有 O_NOFOLLOW／O_DIRECTORY 就沒有安全走法，直接拒絕而不是降級。"""
    if not O_NOFOLLOW or not O_DIRECTORY:
        raise RuntimeFailure(
            "this platform has no O_NOFOLLOW/O_DIRECTORY; refusing to touch drafts"
        )


def open_dir(path: Path) -> int:
    """把一個固定 root 開成 dirfd。它自己是 symlink 也算失敗。"""
    try:
        return os.open(path, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW)
    except OSError as exc:
        raise RuntimeFailure(
            f"cannot open {path} as a real directory: {os.strerror(exc.errno)}"
        ) from exc


def open_dir_at(dir_fd: int, name: str) -> int:
    """開一層父目錄。O_NOFOLLOW 加 O_DIRECTORY 碰到 symlink 會回 ENOTDIR，不是 ELOOP。"""
    try:
        return os.open(name, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW, dir_fd=dir_fd)
    except OSError as exc:
        if exc.errno in (errno.ELOOP, errno.ENOTDIR):
            raise InputError(
                f"{name} is a symlink or not a directory; every directory above "
                "--source must be real"
            ) from exc
        raise InputError(f"cannot open {name}/: {os.strerror(exc.errno)}") from exc


def open_file_at(dir_fd: int, name: str) -> int:
    try:
        return os.open(name, os.O_RDONLY | O_NOFOLLOW, dir_fd=dir_fd)
    except OSError as exc:
        if exc.errno == errno.ELOOP:
            raise InputError(f"{name} is a symlink; --source must be a real file") from exc
        raise InputError(f"cannot open {name}: {os.strerror(exc.errno)}") from exc


def relative_parts(raw: str, root: Path) -> tuple[str, ...] | None:
    """`raw` 在 `root` 底下時回傳相對片段，否則 None。純字串運算，不碰檔案系統。"""
    candidate = PurePosixPath(os.path.normpath(raw))
    base = PurePosixPath(os.path.normpath(str(root)))
    try:
        relative = candidate.relative_to(base)
    except ValueError:
        return None
    parts = relative.parts
    if not parts or any(part in ("", ".", "..") for part in parts):
        return None
    return parts


def read_source(raw: str) -> tuple[bytes, str]:
    """讀 `edit` 的來源圖片，並確認它真的在允許的位置、真的是圖片。

    比對是字面的，不是 resolve 後的：先看它落在哪個固定 root 底下，再從那個 root
    的 dirfd 逐段 O_NOFOLLOW 開下去。任何一段是 symlink 就失敗，所以指到允許範圍
    外的 symlink 不會被讀，父目錄在檢查後被換掉也不會。
    """
    require_secure_flags()
    if not raw.startswith("/"):
        raise InputError(f"--source must be an absolute path: {raw}")
    for root in SOURCE_ROOTS:
        parts = relative_parts(raw, root)
        if parts is not None:
            return read_under(root, parts, raw)
    allowed = ", ".join(str(root) for root in SOURCE_ROOTS)
    raise InputError(f"--source must live under one of: {allowed}")


def read_under(root: Path, parts: tuple[str, ...], raw: str) -> tuple[bytes, str]:
    fds: list[int] = []
    try:
        fds.append(open_dir(root))
        for component in parts[:-1]:
            fds.append(open_dir_at(fds[-1], component))
        fds.append(open_file_at(fds[-1], parts[-1]))
        info = os.fstat(fds[-1])
        if not stat.S_ISREG(info.st_mode):
            raise InputError(f"--source is not a regular file: {raw}")
        if info.st_size == 0:
            raise InputError(f"--source is empty: {raw}")
        if info.st_size > MAX_SOURCE_BYTES:
            raise InputError(
                f"--source is larger than {MAX_SOURCE_BYTES} bytes: {info.st_size} bytes"
            )
        with os.fdopen(fds[-1], "rb", closefd=False) as opened:
            data = opened.read(MAX_SOURCE_BYTES + 1)
    finally:
        for fd in reversed(fds):
            os.close(fd)
    if len(data) > MAX_SOURCE_BYTES:
        raise InputError(f"--source grew past {MAX_SOURCE_BYTES} bytes while being read")
    if data.startswith(PNG_MAGIC):
        return data, "image/png"
    if data.startswith(JPEG_MAGIC):
        return data, "image/jpeg"
    raise InputError(f"--source is not a PNG or JPEG file: {raw}")


def check_prompt(prompt: str) -> str:
    text = prompt.strip()
    if not text:
        raise InputError("--prompt is empty")
    if len(text) > MAX_PROMPT_CHARS:
        raise InputError(f"--prompt is longer than {MAX_PROMPT_CHARS} characters")
    return text


def check_name(name: str) -> str:
    """name 只允許小寫、數字與 `-`，所以它永遠是單一路徑片段，走不出日期目錄。"""
    if not NAME_PATTERN.fullmatch(name):
        raise InputError(
            "--name must match [a-z0-9][a-z0-9-]{0,47} (no slashes, no dots): " + name
        )
    return name


def open_day_dir() -> tuple[int, str]:
    """建立並開啟 drafts 內的 UTC 日期目錄，回傳 (dirfd, 目錄名)。

    DRAFTS_ROOT 本身必須是真目錄（它是 bind mount），日期目錄也必須是 —— 被換成
    symlink 時 O_NOFOLLOW 會失敗，而不是讓後面的寫入落到別的地方。呼叫者要一直
    握著這個 fd，之後所有寫入都相對它，不再走一次 path。
    """
    require_secure_flags()
    day = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    root_fd = open_dir(DRAFTS_ROOT)
    try:
        try:
            os.mkdir(day, 0o750, dir_fd=root_fd)
        except FileExistsError:
            pass
        except OSError as exc:
            raise RuntimeFailure(
                f"cannot create {DRAFTS_ROOT / day}: {os.strerror(exc.errno)}"
            ) from exc
        try:
            return os.open(day, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW, dir_fd=root_fd), day
        except OSError as exc:
            raise RuntimeFailure(
                f"cannot open {DRAFTS_ROOT / day} as a real directory: "
                f"{os.strerror(exc.errno)}"
            ) from exc
    finally:
        os.close(root_fd)


def reserve_name(day_fd: int, name: str) -> str:
    """用 O_CREAT|O_EXCL|O_NOFOLLOW 佔住一個還沒被用的檔名。

    既有的檔案或 symlink 都會讓 O_EXCL 失敗，所以這一步同時做到「不覆寫既有產物」
    與「不寫穿事先種好的 symlink」，兩件事共用同一個 atomic 操作。
    """
    for counter in range(1, MAX_NAME_COLLISIONS + 1):
        candidate = f"{name}.png" if counter == 1 else f"{name}-{counter}.png"
        try:
            os.close(
                os.open(
                    candidate,
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL | O_NOFOLLOW,
                    0o640,
                    dir_fd=day_fd,
                )
            )
            return candidate
        except FileExistsError:
            continue
        except OSError as exc:
            raise RuntimeFailure(
                f"cannot create {candidate}: {os.strerror(exc.errno)}"
            ) from exc
    raise RuntimeFailure(f"too many files named {name} in {DRAFTS_ROOT}")


def store_png(day_fd: int, day: str, name: str, image: bytes) -> Path:
    """把 PNG 原子性地寫進已鎖定的日期目錄，回傳完整路徑。

    先佔住最終檔名，再寫同目錄的暫存檔、fsync、rename 蓋回自己佔的那個名字。
    rename 不追 symlink，所以就算有人在這中間把最終檔名換成 symlink，被換掉的也
    只是那個 symlink 本身。任何一步失敗都不留下半個檔案。
    """
    final = reserve_name(day_fd, name)
    temp = f".{final}.{os.getpid()}.tmp"
    try:
        fd = os.open(
            temp,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | O_NOFOLLOW,
            0o640,
            dir_fd=day_fd,
        )
    except OSError as exc:
        discard(day_fd, final)
        raise RuntimeFailure(f"cannot create {temp}: {os.strerror(exc.errno)}") from exc
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(image)
            handle.flush()
            os.fsync(handle.fileno())
        os.rename(temp, final, src_dir_fd=day_fd, dst_dir_fd=day_fd)
        os.fsync(day_fd)
    except OSError as exc:
        discard(day_fd, temp)
        discard(day_fd, final)
        raise RuntimeFailure(
            f"cannot write {DRAFTS_ROOT / day / final}: {os.strerror(exc.errno)}"
        ) from exc
    return DRAFTS_ROOT / day / final


def discard(day_fd: int, name: str) -> None:
    """best-effort 清掉自己剛建的檔名，失敗不掩蓋原本的錯誤。"""
    try:
        os.unlink(name, dir_fd=day_fd)
    except OSError:
        pass


def build_body(mode: str, prompt: str, size: str, source: tuple[bytes, str] | None) -> dict:
    """Responses API 的請求 body。generate 與 edit 只差在有沒有 input_image。"""
    content: list[dict] = [{"type": "input_text", "text": prompt}]
    if mode == "edit":
        if source is None:
            raise InputError("edit needs --source")
        data, mime = source
        encoded = base64.b64encode(data).decode("ascii")
        content.append(
            {"type": "input_image", "image_url": f"data:{mime};base64,{encoded}"}
        )
    return {
        "model": MODEL,
        "input": [{"role": "user", "content": content}],
        "tools": [{"type": "image_generation", "size": size, "output_format": "png"}],
        "tool_choice": {"type": "image_generation"},
        "store": False,
    }


def call_gateway(body: dict) -> bytes:
    """POST 一次，回傳要寫檔的 PNG bytes。

    JSON 與 SSE 兩種回應都吃，用 Content-Type 決定怎麼讀。解碼與 PNG magic 檢查在
    連線關掉之後才做，所以兩條路徑共用同一組檢查。
    """
    endpoint = gateway_endpoint()
    request = Request(
        endpoint,
        data=json.dumps(body).encode("utf-8"),
        # 固定一個 header，沒有 --header 這種東西；Authorization 由 host proxy 補。
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urlopen(request, timeout=REQUEST_TIMEOUT_SECONDS) as response:
            encoded = read_image_b64(response)
    except HTTPError as exc:
        detail = exc.read().decode("utf-8", "replace")[:500] if exc.fp else ""
        raise RuntimeFailure(f"gateway returned HTTP {exc.code}: {detail}") from exc
    except URLError as exc:
        raise RuntimeFailure(f"cannot reach the gateway: {exc.reason}") from exc
    return decode_png(encoded)


def response_media_type(response) -> str:
    """回應的 media type，小寫、去掉 `; charset=…` 之類的參數。"""
    raw = ""
    getter = getattr(response, "getheader", None)
    if callable(getter):
        raw = getter("Content-Type", "") or ""
    if not raw:
        headers = getattr(response, "headers", None)
        if headers is not None:
            raw = headers.get("Content-Type", "") or ""
    return raw.split(";", 1)[0].strip().lower()


def read_image_b64(response) -> str:
    """從回應裡拿到那張圖的 base64，還沒解碼。"""
    if response_media_type(response) == SSE_MEDIA_TYPE:
        return stream_image_b64(response)
    raw = read_json_body(response)
    if raw[:64].lstrip().startswith((b"data:", b"event:", b"id:", b"retry:", b":")):
        # 有些 gateway 會 stream 但漏掉 Content-Type。body 已經是 SSE 的形狀時就照
        # SSE 讀，不要用「這不是 JSON」把一次已經成功的呼叫丟掉。
        return stream_image_b64(io.BytesIO(raw))
    return payload_image_b64(parse_json_body(raw))


def read_json_body(response) -> bytes:
    """一次讀完非 SSE 的 body，超過上限就失敗。"""
    try:
        raw = response.read(MAX_JSON_BODY_CHARS + 1)
    except (OSError, ValueError) as exc:
        raise RuntimeFailure(f"cannot read the gateway response: {exc}") from exc
    if len(raw) > MAX_JSON_BODY_CHARS:
        raise RuntimeFailure(
            f"gateway response is larger than {MAX_JSON_BODY_CHARS} bytes"
        )
    return raw


def parse_json_body(raw: bytes) -> dict:
    try:
        payload = json.loads(raw)
    except (json.JSONDecodeError, UnicodeDecodeError) as exc:
        raise RuntimeFailure(f"gateway response is not JSON: {exc}") from exc
    if not isinstance(payload, dict):
        raise RuntimeFailure("gateway response is not a JSON object")
    return payload


def payload_image_b64(payload: dict) -> str:
    """從一份完整的 Responses payload 取出第一個 image_generation_call 的 base64。"""
    if not isinstance(payload.get("output"), list):
        raise RuntimeFailure("gateway response has no output array")
    found = payload_images(payload)
    if not found:
        raise RuntimeFailure("gateway response contains no image_generation_call result")
    return found[0][1]


def payload_images(payload: dict) -> list[tuple[str, str]]:
    """payload 裡所有 image_generation_call 的 (output key, base64)，照原本順序。"""
    found: list[tuple[str, str]] = []
    outputs = payload.get("output")
    if not isinstance(outputs, list):
        return found
    for index, item in enumerate(outputs):
        if not isinstance(item, dict) or item.get("type") != "image_generation_call":
            continue
        result = item.get("result")
        if isinstance(result, str) and result:
            found.append((output_key(item.get("id"), index), result))
    return found


def output_key(identifier, index) -> str:
    """同一個 output 的事件要落在同一個 key 上。id 優先，沒有就用 index。"""
    if isinstance(identifier, str) and identifier:
        return f"id:{identifier}"
    if isinstance(index, int):
        return f"index:{index}"
    return "output:0"


def sse_lines(stream):
    """逐行讀 SSE。單行與整份各有上限，所以一行不換行不會把記憶體吃光。"""
    total = 0
    while True:
        try:
            line = stream.readline(MAX_SSE_LINE_CHARS + 1)
        except (OSError, ValueError) as exc:
            raise RuntimeFailure(f"gateway stream ended early: {exc}") from exc
        if not line:
            return
        if len(line) > MAX_SSE_LINE_CHARS:
            raise RuntimeFailure(
                f"gateway stream sent a line over {MAX_SSE_LINE_CHARS} bytes"
            )
        total += len(line)
        if total > MAX_SSE_BODY_CHARS:
            raise RuntimeFailure(
                f"gateway stream is larger than {MAX_SSE_BODY_CHARS} bytes"
            )
        yield line


def sse_events(stream):
    """把行拼成一個個 event 的 data 字串。

    照 SSE 的規則走：`:` 開頭是 comment（keepalive），空行結束一個 event，同一個
    event 的多個 `data:` 用換行接起來。`event:`、`id:`、`retry:` 這裡用不到，讀掉
    就好 —— 要認的是 data 裡的 JSON，不是事件名稱。最後一個 event 沒有以空行收尾
    時照樣送出去。
    """
    data_lines: list[str] = []
    for raw in sse_lines(stream):
        line = raw.decode("utf-8", "replace").rstrip("\r\n")
        if not line:
            if data_lines:
                yield "\n".join(data_lines)
                data_lines = []
            continue
        if line.startswith(":"):
            continue
        field, _, value = line.partition(":")
        if field != "data":
            continue
        data_lines.append(value[1:] if value.startswith(" ") else value)
    if data_lines:
        yield "\n".join(data_lines)


def stream_image_b64(stream) -> str:
    """從 SSE 事件裡挑出要寫檔的那張圖的 base64。

    `partial_image_b64` 每次都是一張完整的圖，不是要接起來的 chunk，所以同一個
    output 後到的取代先到的；收尾事件（帶 `result` 的 output item、或整份 response）
    比 partial 完整，會蓋掉同一個 output 的 partial。多個 output 都有圖時取第一個
    出現的，跟非 SSE 那條路一致。
    """
    images: dict[str, tuple[int, str]] = {}
    order: list[str] = []
    detail = ""
    unparseable = 0
    for data in sse_events(stream):
        if not data.strip() or data.strip() == SSE_DONE:
            continue
        try:
            event = json.loads(data)
        except (json.JSONDecodeError, UnicodeDecodeError):
            unparseable += 1
            continue
        if not isinstance(event, dict):
            unparseable += 1
            continue
        detail = detail or event_error(event)
        for key, rank, encoded in event_images(event):
            if key not in images:
                order.append(key)
            if key not in images or rank >= images[key][0]:
                images[key] = (rank, encoded)
    if order:
        return images[order[0]][1]
    if detail:
        raise RuntimeFailure(f"gateway stream reported an error: {detail}")
    if unparseable:
        raise RuntimeFailure(
            f"gateway stream carried no image; {unparseable} event(s) were not JSON"
        )
    raise RuntimeFailure("gateway stream contains no image_generation_call result")


def event_images(event: dict) -> list[tuple[str, int, str]]:
    """一個 event 裡的 (output key, 完整度, base64)。完整度 1 蓋得掉 0。

    只認 `image_generation_call` 這件事的四種形狀，其他一律忽略：top-level
    `partial_image_b64`（實測回來的那種）、image_generation_call 事件 top-level 的
    `result`、帶 `result` 的 `item`、以及整份 `response` 的 `output[]`。
    """
    found: list[tuple[str, int, str]] = []
    partial = event.get("partial_image_b64")
    if isinstance(partial, str) and partial:
        found.append((event_output_key(event), 0, partial))
    kind = event.get("type")
    result = event.get("result")
    if (
        isinstance(kind, str)
        and "image_generation_call" in kind
        and isinstance(result, str)
        and result
    ):
        found.append((event_output_key(event), 1, result))
    item = event.get("item")
    if isinstance(item, dict) and item.get("type") == "image_generation_call":
        result = item.get("result")
        if isinstance(result, str) and result:
            found.append((event_output_key(event, item), 1, result))
    response = event.get("response")
    if isinstance(response, dict):
        for key, encoded in payload_images(response):
            found.append((key, 1, encoded))
    return found


def event_output_key(event: dict, item: dict | None = None) -> str:
    """partial 事件用 `item_id`，output item 事件用 `item.id`；都沒有就用 index。"""
    identifier = event.get("item_id")
    if not (isinstance(identifier, str) and identifier) and item is not None:
        identifier = item.get("id")
    index = event.get("output_index")
    return output_key(identifier, index if isinstance(index, int) else 0)


def event_error(event: dict) -> str:
    """event 說這次失敗時回一段短說明，其他情況回空字串。

    只取 message／code／type 這種短字串，而且截斷。整個 event 不會被印出來。
    """
    kind = event.get("type") if isinstance(event.get("type"), str) else ""
    candidates = [event.get("error")]
    response = event.get("response")
    if isinstance(response, dict):
        candidates.append(response.get("error"))
        candidates.append(response.get("incomplete_details"))
    failed = kind == "error" or kind.endswith((".failed", ".incomplete"))
    if not failed and all(candidate is None for candidate in candidates):
        return ""
    for candidate in candidates:
        if isinstance(candidate, dict):
            candidate = (
                candidate.get("message") or candidate.get("code") or candidate.get("reason")
            )
        if isinstance(candidate, str) and candidate.strip():
            return candidate.strip()[:MAX_ERROR_DETAIL_CHARS]
    return kind


def decode_png(encoded: str) -> bytes:
    """base64 解成 PNG bytes。錯誤訊息不含 payload 本身。"""
    if len(encoded) > MAX_IMAGE_B64_CHARS:
        raise RuntimeFailure(
            f"image result is larger than {MAX_IMAGE_B64_CHARS} base64 characters"
        )
    # 有的實作會把 base64 折行；validate=True 不吃空白，所以先把空白去掉。
    compact = "".join(encoded.split())
    if not compact:
        raise RuntimeFailure("gateway returned an empty image result")
    try:
        data = base64.b64decode(compact, validate=True)
    except (binascii.Error, ValueError) as exc:
        raise RuntimeFailure(f"image result is not base64: {exc}") from exc
    if not data.startswith(PNG_MAGIC):
        raise RuntimeFailure("gateway returned something that is not a PNG")
    return data


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="company-image",
        description=(
            "透過公司 gateway 產生或編輯圖片，輸出 PNG 到 /home/node/drafts。"
            " 這是這個環境唯一被允許的生圖路徑。"
        ),
    )
    modes = parser.add_subparsers(dest="mode", required=True, metavar="{generate,edit}")

    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--prompt", required=True, help="要畫什麼；純文字")
    common.add_argument(
        "--size",
        default=DEFAULT_SIZE,
        choices=ALLOWED_SIZES,
        help=f"輸出尺寸（預設 {DEFAULT_SIZE}）",
    )
    common.add_argument(
        "--name",
        required=True,
        help="輸出檔名（不含副檔名），只能用 [a-z0-9-]",
    )

    modes.add_parser("generate", parents=[common], help="從 prompt 產生新圖")
    edit = modes.add_parser("edit", parents=[common], help="以既有圖片為基礎修改")
    edit.add_argument(
        "--source",
        required=True,
        help="來源圖片的絕對路徑，必須在 drafts、.openab 或 /tmp 底下",
    )
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    try:
        # 不合法的輸入不必付一次 gateway 呼叫的代價，所以先驗參數、讀來源、
        # 組 body，最後才開日期目錄（drafts 壞掉也要在呼叫前就發現）。
        prompt = check_prompt(args.prompt)
        name = check_name(args.name)
        source = read_source(args.source) if args.mode == "edit" else None
        body = build_body(args.mode, prompt, args.size, source)
        day_fd, day = open_day_dir()
    except InputError as exc:
        print(f"company-image: {exc}", file=sys.stderr)
        return EXIT_INVALID_INPUT
    except RuntimeFailure as exc:
        print(f"company-image: {exc}", file=sys.stderr)
        return EXIT_RUNTIME

    # day_fd 跨過 gateway 呼叫一直握著，所以寫入時的目錄就是驗過的那一個。
    try:
        image = call_gateway(body)
        destination = store_png(day_fd, day, name, image)
    except InputError as exc:
        print(f"company-image: {exc}", file=sys.stderr)
        return EXIT_INVALID_INPUT
    except (RuntimeFailure, OSError) as exc:
        print(f"company-image: {exc}", file=sys.stderr)
        return EXIT_RUNTIME
    finally:
        os.close(day_fd)

    print(destination)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
