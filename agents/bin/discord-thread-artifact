#!/usr/bin/env python3
"""把 drafts 內已存在的產物送回原本那個 Discord thread（或 DM）的唯一入口。

這是單一 container 的內部信任設計：channel、thread 與 message ID 是 OpenAB 放進
prompt 的 <sender_context> 後由 agent 明確帶入，不是 ACP side-channel，更不是不可竄改的
身分驗證資料。此 CLI 只縮小可造成的副作用，不能把 prompt context 變成安全邊界。

送到哪裡照 OpenAB（0.10.0-beta.3 `discord.rs` 的 `build_sender_context`）給的欄位決定：
- 有 `thread_id`：訊息在 thread 裡，送到那個 thread。
- 沒有 `thread_id`、`channel_id` 是 DM：送回 DM（OpenAB 不在 DM 開 thread）。
- 沒有 `thread_id`、在一般頻道：OpenAB 用 `create_thread_from_message` 從觸發訊息開
  thread，Discord 這種 thread 的 ID 就是那則訊息的 ID，所以送到 `message_id`。
DM 與否只能問 Discord（`GET /channels/{id}` 的 type），ID 本身看不出來。

上傳是一個 multipart `POST /channels/{id}/messages`：`payload_json` 帶顯示檔名並關掉
mention，`files[0]` 帶原始 bytes。Discord 前面的 Cloudflare 會擋 urllib 預設的
User-Agent，所以固定送 Discord 要求的 `DiscordBot (url, version)` 格式。

路徑處理不用 resolve()：resolve 會跟著 symlink 走，檢查完的那個字串和之後真正
開到的檔案可以是兩回事。這裡固定從 DRAFTS_ROOT 開一個 dirfd，再逐段
`O_DIRECTORY|O_NOFOLLOW` 往下走；讀取只從那個 fd，刪除只用同一個 parent fd 並
先比對 inode。父目錄或檔案在檢查之後被換掉，結果是失敗，不是逃出 drafts。
"""

from __future__ import annotations

import argparse
import errno
import json
import os
import re
import stat
import sys
from pathlib import Path, PurePosixPath
from urllib.error import HTTPError, URLError
import secrets
from urllib.request import Request, urlopen

DRAFTS_ROOT = Path("/home/node/drafts")
DISCORD_API = "https://discord.com/api/v10"
USER_AGENT = "DiscordBot (https://github.com/henry5720/agent-company, 1)"
ALLOWED_TYPES = {
    ".png": "image/png",
    ".md": "text/markdown",
    ".html": "text/html",
    ".patch": "text/x-patch",
}
SNOWFLAKE_PATTERN = re.compile(r"^[0-9]{17,20}$")
# Discord channel type：1 = DM，3 = group DM。
DM_CHANNEL_TYPES = {1, 3}
PNG_MAGIC = b"\x89PNG\r\n\x1a\n"
# 沒有 boost 的 server 單檔上限 10 MiB；超過的 Discord 會回 40005。
MAX_ARTIFACT_BYTES = 10 * 1024 * 1024
TIMEOUT_SECONDS = 90
EXIT_INVALID_INPUT = 2
EXIT_RUNTIME = 3

O_DIRECTORY = getattr(os, "O_DIRECTORY", 0)
O_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)


class InputError(Exception):
    pass


class RuntimeFailure(Exception):
    pass


class DraftReplaced(Exception):
    """上傳成功後，那個檔名已經不是當初讀的 inode。"""


def discord_token() -> str:
    token = os.environ.get("DISCORD_BOT_TOKEN", "").strip()
    if not token or token == "replace-me":
        raise RuntimeFailure("DISCORD_BOT_TOKEN is not set in the runtime env")
    return token


def require_secure_flags() -> None:
    """沒有 O_NOFOLLOW／O_DIRECTORY 就沒有安全走法，直接拒絕而不是降級。"""
    if not O_NOFOLLOW or not O_DIRECTORY:
        raise RuntimeFailure(
            "this platform has no O_NOFOLLOW/O_DIRECTORY; refusing to touch drafts"
        )


def draft_parts(raw: str) -> tuple[str, ...]:
    """把 --file 拆成相對 DRAFTS_ROOT 的路徑片段。純字串運算，不碰檔案系統。

    normpath 只做字面折疊，所以 `..` 走不出 root；真正的保證來自後面的 dirfd 走法。
    """
    if not raw.startswith("/"):
        raise InputError(f"--file must be an absolute path under {DRAFTS_ROOT}")
    candidate = PurePosixPath(os.path.normpath(raw))
    root = PurePosixPath(os.path.normpath(str(DRAFTS_ROOT)))
    try:
        relative = candidate.relative_to(root)
    except ValueError:
        raise InputError(f"--file must live under {DRAFTS_ROOT}") from None
    parts = relative.parts
    if not parts or any(part in ("", ".", "..") for part in parts):
        raise InputError(f"--file must name a file under {DRAFTS_ROOT}")
    return parts


def open_root() -> int:
    try:
        return os.open(DRAFTS_ROOT, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW)
    except OSError as exc:
        raise RuntimeFailure(
            f"cannot open {DRAFTS_ROOT} as a real directory: {os.strerror(exc.errno)}"
        ) from exc


def open_dir_at(dir_fd: int, name: str) -> int:
    """開一層父目錄。O_NOFOLLOW 加 O_DIRECTORY 碰到 symlink 會回 ENOTDIR，不是 ELOOP。"""
    try:
        return os.open(name, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW, dir_fd=dir_fd)
    except OSError as exc:
        if exc.errno in (errno.ELOOP, errno.ENOTDIR):
            raise InputError(
                f"{name} is a symlink or not a directory; every directory above "
                "--file must be real"
            ) from exc
        raise InputError(f"cannot open {name}/: {os.strerror(exc.errno)}") from exc


def open_file_at(dir_fd: int, name: str) -> int:
    try:
        return os.open(name, os.O_RDONLY | O_NOFOLLOW, dir_fd=dir_fd)
    except OSError as exc:
        if exc.errno == errno.ELOOP:
            raise InputError(f"{name} is a symlink; --file must be a real file") from exc
        raise InputError(f"cannot open {name}: {os.strerror(exc.errno)}") from exc


def identity(info: os.stat_result) -> tuple:
    """判斷「還是同一個檔案嗎」用的欄位。

    只比 st_dev/st_ino 不夠：同一個目錄裡刪掉再建一個檔案，很容易拿到剛釋放的
    inode number。加上 mode、size 與兩個時間戳，換掉的檔案就對不上了。
    """
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


class Draft:
    """一份已被 dirfd 鎖定的草稿：資料在記憶體，刪除只走同一個 parent fd。"""

    def __init__(self, parent_fd: int, name: str, data: bytes, mime: str, info: os.stat_result):
        self.parent_fd = parent_fd
        self.name = name
        self.data = data
        self.mime = mime
        self.info = info

    def unlink(self) -> None:
        """刪掉當初讀的那個檔案，不是現在剛好叫這個名字的東西。"""
        current = os.lstat(self.name, dir_fd=self.parent_fd)
        if not stat.S_ISREG(current.st_mode) or identity(current) != identity(self.info):
            raise DraftReplaced(
                f"{self.name} was replaced after it was read; left in place for cleanup"
            )
        os.unlink(self.name, dir_fd=self.parent_fd)

    def close(self) -> None:
        os.close(self.parent_fd)

    def __enter__(self) -> "Draft":
        return self

    def __exit__(self, *_exc) -> bool:
        self.close()
        return False


def open_draft(raw: str) -> Draft:
    """從 DRAFTS_ROOT 逐段走到 --file，讀進記憶體，並把 parent fd 留著給刪除用。"""
    require_secure_flags()
    parts = draft_parts(raw)
    name = parts[-1]
    mime = ALLOWED_TYPES.get(PurePosixPath(name).suffix.lower())
    if mime is None:
        raise InputError("--file must end in .png, .md, .html, or .patch")

    ancestors: list[int] = []
    parent_fd: int | None = None
    fd: int | None = None
    try:
        ancestors.append(open_root())
        for component in parts[:-1]:
            ancestors.append(open_dir_at(ancestors[-1], component))
        # 最後一段的 parent 要留著：上傳結束後只從它 unlink，不再走一次 path。
        parent_fd = ancestors.pop()
        fd = open_file_at(parent_fd, name)
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise InputError("--file must be a regular file")
        if info.st_size == 0 or info.st_size > MAX_ARTIFACT_BYTES:
            raise InputError(f"--file must be between 1 and {MAX_ARTIFACT_BYTES} bytes")
        with os.fdopen(fd, "rb", closefd=False) as opened:
            data = opened.read(MAX_ARTIFACT_BYTES + 1)
        if len(data) != info.st_size:
            raise InputError("--file changed size while it was being read")
        if mime == "image/png" and not data.startswith(PNG_MAGIC):
            raise InputError(".png artifact does not have PNG magic")
    except BaseException:
        if parent_fd is not None:
            os.close(parent_fd)
        raise
    finally:
        if fd is not None:
            os.close(fd)
        for extra in ancestors:
            os.close(extra)
    return Draft(parent_fd, name, data, mime, info)


def validate_snowflake(option: str, value: str | None) -> str | None:
    if value is not None and not SNOWFLAKE_PATTERN.fullmatch(value):
        raise InputError(f"{option} must be a Discord ID from <sender_context>")
    return value


def discord_request(method: str, path: str, token: str, body: bytes | None = None,
                    content_type: str | None = None) -> dict:
    headers = {"Authorization": f"Bot {token}", "User-Agent": USER_AGENT}
    if content_type:
        headers["Content-Type"] = content_type
    request = Request(f"{DISCORD_API}{path}", data=body, headers=headers, method=method)
    try:
        with urlopen(request, timeout=TIMEOUT_SECONDS) as response:
            result = json.loads(response.read())
    except HTTPError as exc:
        # Discord 的錯誤 body 是 {"code": ..., "message": ...}；只印這兩個，不印 request。
        try:
            detail = json.loads(exc.read())
            reason = f"{detail.get('code')} {detail.get('message')}"
        except (OSError, ValueError, AttributeError):
            reason = "no error body"
        raise RuntimeFailure(f"Discord {method} {path.split('/')[1]} returned HTTP {exc.code}: {reason}") from exc
    except (URLError, OSError, json.JSONDecodeError) as exc:
        raise RuntimeFailure(f"Discord {method} {path.split('/')[1]} request failed: {exc}") from exc
    if not isinstance(result, dict):
        raise RuntimeFailure("Discord returned an invalid response")
    return result


def is_dm(channel: str, token: str) -> bool:
    return discord_request("GET", f"/channels/{channel}", token).get("type") in DM_CHANNEL_TYPES


def target_channel(channel: str, thread: str | None, message: str | None, token: str) -> str:
    """回傳要 POST 的 channel ID；規則見檔頭。"""
    if thread:
        return thread
    if is_dm(channel, token):
        return channel
    if not message:
        raise InputError("--message is required outside a thread or DM")
    return message


def multipart(draft: Draft) -> tuple[bytes, str]:
    boundary = f"agent-company-{secrets.token_hex(16)}"
    payload = json.dumps(
        {
            "attachments": [{"id": 0, "filename": draft.name}],
            "allowed_mentions": {"parse": []},
        },
        ensure_ascii=False,
    )
    # header 裡的檔名固定 ASCII；顯示用的 UTF-8 檔名放在 payload_json。
    ascii_name = "artifact" + PurePosixPath(draft.name).suffix.lower()
    body = b"".join(
        [
            f"--{boundary}\r\n".encode(),
            b'Content-Disposition: form-data; name="payload_json"\r\n',
            b"Content-Type: application/json\r\n\r\n",
            payload.encode("utf-8"),
            f"\r\n--{boundary}\r\n".encode(),
            f'Content-Disposition: form-data; name="files[0]"; filename="{ascii_name}"\r\n'.encode(),
            f"Content-Type: {draft.mime}\r\n\r\n".encode(),
            draft.data,
            f"\r\n--{boundary}--\r\n".encode(),
        ]
    )
    return body, f"multipart/form-data; boundary={boundary}"


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="discord-thread-artifact")
    parser.add_argument("--file", help="drafts 內的絕對 .png、.md、.html 或 .patch 路徑")
    parser.add_argument("--channel", required=True, help="<sender_context> 的 channel_id")
    parser.add_argument("--thread", help="<sender_context> 的 thread_id（有才帶）")
    parser.add_argument("--message", help="<sender_context> 的 message_id")
    parser.add_argument("--check-dm", action="store_true", help="只回答 --channel 是不是 DM，印 dm 或 channel")
    args = parser.parse_args(argv)
    if not args.check_dm and not args.file:
        parser.error("--file is required unless --check-dm")
    return args


def deliver(draft: Draft, target: str, token: str) -> None:
    body, content_type = multipart(draft)
    result = discord_request("POST", f"/channels/{target}/messages", token, body, content_type)
    if not result.get("attachments"):
        raise RuntimeFailure("Discord accepted the message but attached no file")


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    try:
        channel = validate_snowflake("--channel", args.channel)
        thread = validate_snowflake("--thread", args.thread)
        message = validate_snowflake("--message", args.message)
        token = discord_token()
        if args.check_dm:
            print("dm" if is_dm(channel, token) else "channel")
            return 0
        draft = open_draft(args.file)
    except (InputError, RuntimeFailure) as exc:
        print(f"discord-thread-artifact: {exc}", file=sys.stderr)
        return EXIT_INVALID_INPUT if isinstance(exc, InputError) else EXIT_RUNTIME

    with draft:
        try:
            target = target_channel(channel, thread, message, token)
            deliver(draft, target, token)
        except (InputError, RuntimeFailure, OSError) as exc:
            print(f"discord-thread-artifact: {exc}", file=sys.stderr)
            return EXIT_INVALID_INPUT if isinstance(exc, InputError) else EXIT_RUNTIME
        # 檔案已經送到對方手上，所以刪不掉不算交付失敗：說清楚並留給 24 小時
        # cleanup，不要回非零讓 agent 以為要重傳。
        try:
            draft.unlink()
        except DraftReplaced as exc:
            print(f"discord-thread-artifact: {exc}", file=sys.stderr)
        except OSError as exc:
            print(
                f"discord-thread-artifact: uploaded {draft.name} but could not delete it: {exc}",
                file=sys.stderr,
            )
        print(f"uploaded {draft.name} to {target}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
