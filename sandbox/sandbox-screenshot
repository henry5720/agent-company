#!/usr/bin/env node
// 在 prototype sandbox 內對 dev server／Storybook 截圖，PNG 只寫到 $OUT_DIR。
//
// 用法：sandbox-screenshot [--wait 秒] [--width N] [--height N] [--full-page] <url> <name.png>
//
// --wait：先輪詢 url 直到 dev server 回應（預設 180 秒），讓 agent 能在同一個
// `bash -c` 裡背景起 dev server 再截圖。Playwright 是 image 自己釘的版本，跟
// repo 裡的 @playwright/test 脫鉤（spec §7）。
'use strict';

const path = require('node:path');
const { chromium } = require('/usr/local/lib/node_modules/playwright');

function usage(message) {
  console.error(`sandbox-screenshot: ${message}`);
  console.error('usage: sandbox-screenshot [--wait SECONDS] [--width N] [--height N] [--full-page] <url> <name.png>');
  process.exit(2);
}

function parse(argv) {
  const options = { wait: 180, width: 1440, height: 900, fullPage: false, rest: [] };
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === '--full-page') options.fullPage = true;
    else if (['--wait', '--width', '--height'].includes(arg)) {
      const value = Number(argv[++i]);
      if (!Number.isInteger(value) || value < 0 || value > 10000) usage(`${arg} needs an integer`);
      options[arg.slice(2)] = value;
    } else if (arg.startsWith('--')) usage(`unknown option ${arg}`);
    else options.rest.push(arg);
  }
  if (options.rest.length !== 2) usage('need <url> and <name.png>');
  const [url, name] = options.rest;
  if (!/^https?:\/\//.test(url)) usage('url must be http(s)');
  if (!/^[A-Za-z0-9][A-Za-z0-9._-]{0,99}\.png$/.test(name)) usage('name must be a plain *.png file name');
  if (!process.env.OUT_DIR) usage('OUT_DIR is not set; run this through sandbox-run');
  return { ...options, url, file: path.join(process.env.OUT_DIR, name) };
}

async function waitForServer(url, seconds) {
  const deadline = Date.now() + seconds * 1000;
  for (;;) {
    try {
      const response = await fetch(url, { signal: AbortSignal.timeout(5000) });
      if (response.status < 500) return;
    } catch {
      // dev server 還沒起來。
    }
    if (Date.now() > deadline) throw new Error(`${url} did not respond within ${seconds}s`);
    await new Promise((resolve) => setTimeout(resolve, 1000));
  }
}

async function main() {
  const options = parse(process.argv.slice(2));
  if (options.wait > 0) await waitForServer(options.url, options.wait);
  const browser = await chromium.launch();
  try {
    const page = await browser.newPage({ viewport: { width: options.width, height: options.height } });
    await page.goto(options.url, { waitUntil: 'load', timeout: 300000 });
    // vite dev 首次載入有上千個 module 請求；等 network idle，但不讓它卡死截圖。
    await page.waitForLoadState('networkidle', { timeout: 60000 }).catch(() => {});
    await page.screenshot({ path: options.file, fullPage: options.fullPage });
  } finally {
    await browser.close();
  }
  console.log(`sandbox-screenshot: wrote ${options.file}`);
}

main().catch((error) => {
  console.error(`sandbox-screenshot: ${error.message}`);
  process.exit(3);
});
