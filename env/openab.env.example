# 複製成 env/openab.env（不進 Git，chmod 600），把 replace-me 和空值填好。
# 這些值都會進 agent 的 container，沒有 token 隔離（ADR 0012）。

# 必填：Developer Portal > Bot > Reset Token
DISCORD_BOT_TOKEN=replace-me

# 必填：公司 gateway。BASE_URL 是 `<BASE_URL>/responses` 的前綴（不是 /v1），https、結尾不帶 /
COMPANY_GATEWAY_BASE_URL=https://replace-me
COMPANY_GATEWAY_API_KEY=replace-me

# 必填：Cloudflare R2（收附件）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 選填：MCP 的 key，沒填那個 MCP 不能用
CONTEXT7_API_KEY=
GRAPHIFY_API_KEY=

# 排障時改成 openab=debug
RUST_LOG=openab=info
