# bot、prototype sandbox 與 host proxy 共用的網路位址正本（spec #21 §2、矛盾 5）。
#
# 讀這份檔案的有三個地方，改任何一個值都要三邊一起動：
# - scripts/host-firewall.sh：防火牆規則（裝到 /etc/work-agent/ 後由 systemd unit 讀）。
# - scripts/install-host-network.sh：建 Docker network、裝 Caddy unit。
# - config/caddy/Caddyfile：經 systemd EnvironmentFile 取 bind 位址與 port。
# compose.yaml 不能直接讀這份檔案，所以 compose 內寫死的值必須跟這裡一致；
# tests/host-network.py 會比對（compose 接上 network 之後）。
#
# 格式：只允許 `KEY=value`，不加引號、不含空白。bash 腳本用 read loop 解析、不 source，
# systemd EnvironmentFile 也直接吃同一份。

# Docker network。由 install-host-network.sh 建立，compose 以 `external: true` 引用，
# 所以 `docker compose down` 不會把它（和 proxy 綁的位址）拿掉。
WORK_AGENT_NETWORK=work-agent-net

# Linux bridge 介面名稱（com.docker.network.bridge.name，最長 15 字元）。
# 防火牆規則全部用 `-i` 這個名字限定範圍，不碰 host 上其他 Docker network。
WORK_AGENT_BRIDGE=br-work-agent

# 10.231.0.0/24 刻意不在 Docker 預設 address pool（172.17–31/16、192.168/16）內，
# 其他 compose project 自動配網段時不會搶到；也不跟 AWS VPC 的 172.31.0.0/16 重疊。
WORK_AGENT_SUBNET=10.231.0.0/24

# Docker 動態配發 IP 只從這段拿，固定位址（gateway、bot）放在這段之外，不會撞號。
WORK_AGENT_IP_RANGE=10.231.0.128/25

# bridge 在 host 上的位址，也是 host Caddy proxy 的 bind 位址。
WORK_AGENT_GATEWAY_IP=10.231.0.1

# bot container 的固定位址。防火牆只認這個 IP 是 bot；同一個 network 上其他位址
# 一律當 sandbox 對待（fail closed），所以 sandbox 不需要固定 IP。
WORK_AGENT_BOT_IP=10.231.0.10

# host Caddy proxy 的 port。bot 內 COMPANY_GATEWAY_BASE_URL 指向
# http://10.231.0.1:18080（Codex base_url 同一個）。
WORK_AGENT_PROXY_PORT=18080

# sandbox runner 的 port，要跟 agents/bin/sandbox-run 的 DEFAULT_RUNNER_URLS 一致。
WORK_AGENT_RUNNER_PORT=8080

# sandbox 用的 DNS（compose 的 `dns:`）。sandbox 連不到私有 IP 段，Docker 內建 DNS
# 從 sandbox 的 network namespace 往上游轉送，上游若是 VPC resolver（172.31.0.2）會被擋，
# 所以 sandbox 改用公開 resolver。逗號分隔。
WORK_AGENT_SANDBOX_DNS=1.1.1.1,8.8.8.8
