# 版本正本。Build 與 deploy 的每一個版本都從這裡取值。
#
# 規則：
# - 不得出現 `latest`、`beta`、`stable` 或任何浮動 tag。
# - OpenAB image 必須帶 immutable digest；tag 只是給人看的。
# - 這個檔案進 Git，改動要當成升級 review。
# - Compose build args mirror the pinned values below so plain `docker compose`
#   is usable without a wrapper.

# OpenAB 版本。
OPENAB_VERSION=0.10.0-beta.3

# ghcr.io/openabdev/openab:0.10.0-beta.3-opencode（multi-arch：linux/amd64、linux/arm64）
OPENAB_IMAGE=ghcr.io/openabdev/openab:0.10.0-beta.3-opencode@sha256:44abe31bc0cdb462e1177930590ce52c597e454ea817cd744b5f360875009561

# 自包的 opencode-ai 版本。Dockerfile 會用獨立 prefix
# /opt/opencode-${OPENCODE_VERSION} exact-install，並驗證 /usr/local/bin/opencode
# 的 symlink resolved path 與 CLI version 都完全一致；runtime 不依賴 base image 版本。
OPENCODE_VERSION=1.18.13

# oh-my-opencode-slim（OMO）plugin。這個值同時要出現在
# config/opencode/opencode.json 的 plugin pin，tests/static.sh 會比對兩邊一致。
OMO_VERSION=2.2.15

# CodeGraph CLI。
CODEGRAPH_VERSION=1.5.0

# OMO 的 Claude Code ACP adapter。Dockerfile 直接安裝這個 exact version；
# runtime 不得用 npx 下載未固定的 package。
CLAUDE_AGENT_ACP_VERSION=0.70.0

# Claude Code CLI。Dockerfile 以 exact version 安裝，避免依賴 base image 的浮動版本。
CLAUDE_CODE_VERSION=2.1.236

# Docling PDF parser；Dockerfile 只從這個 pin 安裝，不得另寫版本。
DOCLING_VERSION=2.121.0

# prototype sandbox base image（spec #21 §7）：node bookworm 完整版，版本對齊前端的
# `.nvmrc`（22.16.0）。digest 是 multi-arch index（linux/amd64、linux/arm64 等）。
SANDBOX_NODE_IMAGE=node:22.16.0-bookworm@sha256:71bcbb3b215b3fa84b5b167585675072f4c270855e37a599803f1a58141a0716

# prototype sandbox 自己釘的 Playwright；build 時 `playwright install --with-deps chromium`，
# 跟各 repo 的 @playwright/test 版本脫鉤。
PLAYWRIGHT_VERSION=1.64.0

# host Caddy proxy（spec #21 §4；#25）。不是 container：scripts/install-host-network.sh 從
# GitHub release 下載這個版本的靜態 binary 裝到 /opt/caddy-${CADDY_VERSION}/caddy，
# 下面的 SHA-512 取自同一個 release 的 caddy_${CADDY_VERSION}_checksums.txt，不符就不裝。
# 升級時三個值一起改。
CADDY_VERSION=2.11.7
CADDY_LINUX_AMD64_SHA512=a7a433a1b133efc3c8d10eb0b99d52a24b5ef5c322dc77f5282182b1c0402139ab83f3a99f0c52409df77d20123fb0b523edad8a66d8f5e49136197bf61ef0e7
CADDY_LINUX_ARM64_SHA512=3db36ba90c7a6e8dda40ee3dd71fa08844c76b5fb08f61b31e5e78d2ed38e71c51dc7baed875e50d1ca1279196e84302967237386ae87c91ae9f2aaceada682e
